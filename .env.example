# The server reads these from the process environment (systemd unit, launchd plist, docker env, ...).
PORT=4174                      # listens on 127.0.0.1 only; put a TLS reverse proxy in front
APP_HOST=                      # public hostname, e.g. health.example.com (requests for other hosts are rejected)
APP_NAME=ApniHealth            # shown in the page title, calendar exports and notifications
APP_TIME_ZONE=                 # IANA zone for medicine schedules and reminders, e.g. Europe/Berlin (default: server zone)
NO_PUSH=                       # set to 1 to disable sending web-push reminders (tests/dev)
VAPID_SUBJECT=                 # optional mailto: or https: contact for push services (default: https://APP_HOST)
MEMBERS_FILE=                  # optional path to members.json (default: private/members.json)

# Authentication (for now): Cloudflare Access, or a proxy that issues the same signed JWT header.
CF_ACCESS_ISSUER=              # https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=                 # Access application AUD tag
CF_ACCESS_EMAIL=               # comma-separated identities allowed in
LOGOUT_URL=                    # optional; default /cdn-cgi/access/logout
CA_BUNDLE=                     # optional CA bundle path for fetching the Access signing keys
