# The server reads these from the process environment (systemd unit, launchd plist, docker env, ...).
PORT=4174                      # listens on 127.0.0.1 only; put a TLS reverse proxy in front
APP_HOST=                      # public hostname, e.g. health.example.com (requests for other hosts are rejected)
APP_NAME=ApniHealth            # shown in the page title, calendar exports and notifications
DEMO_NOTICE=                   # optional banner on every page of a demo/test instance, e.g. "Demo: data may be wiped. Do not enter real health data."
APP_TIME_ZONE=                 # default IANA zone for households that have not picked one in setup, e.g. Europe/Berlin (default: server zone)
NO_PUSH=                       # set to 1 to disable sending web-push reminders (tests/dev)
VAPID_SUBJECT=                 # optional mailto: or https: contact for push services (default: https://APP_HOST)
DB_FILE=                       # optional path to the SQLite database (default: private/apnihealth.db)

# Sign-in: builtin (email links, default) or trusted-proxy (Cloudflare Access or a proxy issuing the same JWT).
AUTH_MODE=builtin
PRIVACY_URL=                   # optional: link to your privacy notice (see docs/PRIVACY-TEMPLATE.md)
SIGNUP_MODE=open               # builtin: open (anyone with a verified email can sign up) or invite (invites only)
SMTP_URL=                      # builtin: smtps://user:pass@host:465 or smtp://user:pass@host:587 (STARTTLS required); empty: links go to the log
SMTP_FROM=                     # builtin: sender, e.g. "ApniHealth <health@example.com>"
TRUSTED_PROXY_ROLE=            # trusted-proxy: role for new users after the first owner: editor (default) or viewer

# trusted-proxy only:
CF_ACCESS_ISSUER=              # https://<team>.cloudflareaccess.com
CF_ACCESS_AUD=                 # Access application AUD tag
CF_ACCESS_EMAIL=               # comma-separated identities allowed in
LOGOUT_URL=                    # optional; default /cdn-cgi/access/logout
CA_BUNDLE=                     # optional CA bundle path for fetching the Access signing keys
